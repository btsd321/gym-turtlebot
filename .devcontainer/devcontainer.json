// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
	"dockerFile": "Dockerfile",
	"build": {
		"args": {
			"WORKSPACE": "${containerWorkspaceFolder}",
			"DOCKER_MIRROR": "${localEnv:MY_XY_DOMAIN_NAME:docker.io}"
		}
	},
	"remoteUser": "ros",
	// 在容器启动前，确保宿主机 .ssh 目录和 .Xauthority 文件存在（Windows 无 HOME 变量，需提前创建）
	"initializeCommand": {
		"init-ssh": "powershell -Command \"New-Item -Force -ItemType Directory $env:USERPROFILE\\.ssh | Out-Null\"",
		"init-xauthority": "powershell -Command \"New-Item -Force -ItemType File $env:USERPROFILE\\.Xauthority | Out-Null\""
	},
	"mounts": [
		"source=${localEnv:USERPROFILE}/.ssh,target=/home/ros/.ssh,type=bind,consistency=cached,readonly",
		// 将宿主机的 X11 认证文件挂载进容器，使 SSH X11 转发的 cookie 可用
		"source=${localEnv:USERPROFILE}/.Xauthority,target=/home/ros/.Xauthority,type=bind,consistency=cached"
	],
	"runArgs": [
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		"--volume=/tmp/.X11-unix:/tmp/.X11-unix",
		"--volume=/mnt/wslg:/mnt/wslg",
		"--ipc=host",
		"--gpus=all",
		// 运行时补充 GID，使 ros 用户实际获得宿主机 render/video 组的 DRI 访问权
		"--group-add=video",
		"--group-add=render"
	],
	"containerEnv": {
		// Windows Docker Desktop 宿主机固定 IP 为 host.docker.internal (192.168.65.254)
		// 需在 Windows 上启动 MobaXterm 并将 X11 remote access 设为 full
		// 注意：resolv.conf 中的 nameserver (192.168.65.7) 仅为 DNS，不是宿主机 IP
		"DISPLAY": "host.docker.internal:0.0",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"PULSE_SERVER": "${localEnv:PULSE_SERVER}",
		// MobaXterm X Server 不支持硬件 OpenGL 直通，必须使用 Mesa 软件渲染
		"LIBGL_ALWAYS_SOFTWARE": "1",
		"NVIDIA_VISIBLE_DEVICES": "all",
		"NVIDIA_DRIVER_CAPABILITIES": "all",
		// 固定 XDG_RUNTIME_DIR 到容器内可写目录，避免 /run/user/1001 Permission denied
		// 导致 Qt/Wayland/EGL 初始化异常
		"XDG_RUNTIME_DIR": "/tmp/runtime-ros",
		// 指向挂载进容器的 Xauthority 文件
		"XAUTHORITY": "/home/ros/.Xauthority",
		// 禁用 FastDDS SHM 传输，避免容器重启后残留的 /dev/shm/fastrtps_* 段
		// 导致 RCL 上下文初始化失败（rviz2 SIGABRT）
		"FASTRTPS_DEFAULT_PROFILES_FILE": "/workspaces/gym-turtlebot/.devcontainer/fastdds_no_shm.xml",
		// VS Code 插件（Copilot/Claude 等）走静态代理，使用 Docker bridge 网关 172.18.0.1
		// 需在 Windows 管理员 PowerShell 配置 netsh portproxy（重启后保留）：
		//   netsh interface portproxy add v4tov4 listenaddress=172.18.0.1 listenport=19828 connectaddress=127.0.0.1 connectport=19828
		// 不能用 127.0.0.1（容器内是 WSL2 VM loopback，连不到 Windows 代理）
		// 终端 shell 会话由 /etc/profile.d/99-proxy.sh 动态覆盖为实际网关地址
		"HTTP_PROXY": "http://172.18.0.1:19828",
		"HTTPS_PROXY": "http://172.18.0.1:19828",
		"http_proxy": "http://172.18.0.1:19828",
		"https_proxy": "http://172.18.0.1:19828",
		// ROS/Gazebo 本地通信不走代理
		"NO_PROXY": "localhost,127.0.0.0/8,::1",
		"no_proxy": "localhost,127.0.0.0/8,::1"
	},
	// 容器启动后：
	// 1. 写入动态代理：检测默认网关，生成 /etc/profile.d/99-proxy.sh，供所有终端 shell 会话使用
	// 2. 修复 /dev/dri/* 权限（GID 不匹配导致 libEGL Permission denied → Ogre2 segfault）
	// 3. 修复 XDG_RUNTIME_DIR（Qt/EGL 需要可写的 runtime dir）
	// 4. 创建 NVIDIA EGL GLVND ICD：nvidia-container-toolkit 注入了 libEGL_nvidia.so.0，
	//    但容器内缺少对应的 ICD JSON，导致 GLVND 不知道去调用 NVIDIA 专有 EGL，
	//    Mesa 回退 DRI2 路径失败（driver (null)）→ Ogre2 传感器线程 segfault
	// 5. 允许本地无鉴权 X 连接
	// 6. 清理残留 FastDDS SHM 段
	"postStartCommand": "GATEWAY=$(ip route 2>/dev/null | grep default | awk '{print $3}' | head -1) && [ -n \"$GATEWAY\" ] && printf 'export http_proxy=http://%s:19828\\nexport https_proxy=http://%s:19828\\nexport HTTP_PROXY=http://%s:19828\\nexport HTTPS_PROXY=http://%s:19828\\nexport NO_PROXY=localhost,127.0.0.0/8,::1\\nexport no_proxy=localhost,127.0.0.0/8,::1\\n' \"$GATEWAY\" \"$GATEWAY\" \"$GATEWAY\" \"$GATEWAY\" | sudo tee /etc/profile.d/99-proxy.sh > /dev/null || true && [ -n \"$GATEWAY\" ] && git config --global http.proxy \"http://$GATEWAY:19828\" && git config --global https.proxy \"http://$GATEWAY:19828\" || true && git config --global core.autocrlf input && git config --global core.eol lf && sudo chmod a+rw /dev/dri/* 2>/dev/null || true && mkdir -p /tmp/runtime-ros && chmod 700 /tmp/runtime-ros && sudo mkdir -p /usr/share/glvnd/egl_vendor.d && (test -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json || printf '{\"file_format_version\":\"1.0.0\",\"ICD\":{\"library_path\":\"libEGL_nvidia.so.0\"}}' | sudo tee /usr/share/glvnd/egl_vendor.d/10_nvidia.json >/dev/null) 2>/dev/null || true && xhost +local: 2>/dev/null || true && rm -f /dev/shm/fastrtps_* 2>/dev/null || true",
	// Set *default* container specific settings.json values on container create.
	"customizations": {
		"vscode": {
			"extensions": [
				"althack.ament-task-provider",
				"betwo.b2-catkin-tools",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-docker",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"ms-vscode.cpptools",
				"redhat.vscode-yaml",
				"smilerobotics.urdf",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"yzhang.markdown-all-in-one",
				"zachflower.uncrustify"
			]
		}
	}
}
