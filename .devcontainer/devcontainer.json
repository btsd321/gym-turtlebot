// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
	"dockerFile": "Dockerfile",
	"build": {
		"args": {
			"WORKSPACE": "${containerWorkspaceFolder}",
			"DOCKER_MIRROR": "${localEnv:MY_XY_DOMAIN_NAME:docker.io}"
		}
	},
	"remoteUser": "ros",
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/ros/.ssh,type=bind,consistency=cached,readonly",
		// 将宿主机的 X11 认证文件挂载进容器，使 SSH X11 转发的 cookie 可用
		"source=${localEnv:HOME}/.Xauthority,target=/home/ros/.Xauthority,type=bind,consistency=cached"
	],
	"runArgs": [
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		"--volume=/tmp/.X11-unix:/tmp/.X11-unix",
		"--volume=/mnt/wslg:/mnt/wslg",
		"--ipc=host",
		"--gpus=all",
		// uncomment to use intel iGPU
		// "--device=/dev/dri"
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}", // Needed for GUI try ":0" for windows
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		"PULSE_SERVER": "${localEnv:PULSE_SERVER}",
		"LIBGL_ALWAYS_SOFTWARE": "0",
		"NVIDIA_VISIBLE_DEVICES": "all",
		"NVIDIA_DRIVER_CAPABILITIES": "all",
		// 指向挂载进容器的 Xauthority 文件
		"XAUTHORITY": "/home/ros/.Xauthority",
		// 禁用 FastDDS SHM 传输，避免容器重启后残留的 /dev/shm/fastrtps_* 段
		// 导致 RCL 上下文初始化失败（rviz2 SIGABRT）
		"FASTRTPS_DEFAULT_PROFILES_FILE": "/workspaces/gym-turtlebot/.devcontainer/fastdds_no_shm.xml"
	},
	// 容器启动后允许本地无鉴权 X 连接；同时清理残留 FastDDS SHM 段
	"postStartCommand": "xhost +local: 2>/dev/null || true && rm -f /dev/shm/fastrtps_* 2>/dev/null || true",
	// Set *default* container specific settings.json values on container create.
	"customizations": {
		"vscode": {
			"extensions": [
				"althack.ament-task-provider",
				"betwo.b2-catkin-tools",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-docker",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"ms-vscode.cpptools",
				"redhat.vscode-yaml",
				"smilerobotics.urdf",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"yzhang.markdown-all-in-one",
				"zachflower.uncrustify"
			]
		}
	}
}
